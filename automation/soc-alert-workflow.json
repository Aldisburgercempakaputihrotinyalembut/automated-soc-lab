    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst w = raw.body ?? raw;\nconst a = w.all_fields ?? w;\n\nconst rule = a.rule ?? {};\nconst md = rule.mitre ?? {};\nconst agent = a.agent ?? {};\nconst data = a.data ?? {};\nconst ed = data.win?.eventdata ?? {};\n\nconst source_ip =\n  ed.ipAddress ?? data.srcip ?? data.src_ip ?? ed.sourceIp ?? null;\n\n// --- SOC-015: deteksi IP privat (RFC1918 + loopback + link-local) ---\nconst ip = source_ip ?? \"\";\nconst is_private =\n  ip === \"\" ||\n  /^(10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.)/.test(ip);\n\nreturn [{\n  json: {\n    timestamp: a.timestamp ?? w.timestamp ?? null,\n    rule_id: rule.id ?? w.rule_id ?? null,\n    rule_level: rule.level ?? null,\n    rule_desc: rule.description ?? w.title ?? null,\n    mitre_id: md.id ?? null,\n    mitre_technique: md.technique ?? null,\n    agent_name: agent.name ?? null,\n    agent_ip: agent.ip ?? null,\n    source_ip,\n    is_private,\n    command_line: ed.commandLine ?? null,\n    full_log: a.full_log ?? w.text ?? null,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
