    {
      "parameters": {
        "jsCode": "// Data dari AbuseIPDB (node sebelumnya = HTTP Request)\nconst abuse = $input.first().json.data ?? {};\n// Alert asli dari Code node (referensi by name)\nconst alert = $('Code in JavaScript').item.json;\n\nconst score = abuse.abuseConfidenceScore ?? 0;\n\nreturn [{\n  json: {\n    ...alert,\n    enrichment: \"abuseipdb\",\n    abuse_score: score,\n    abuse_country: abuse.countryCode ?? null,\n    abuse_isp: abuse.isp ?? null,\n    abuse_domain: abuse.domain ?? null,\n    abuse_total_reports: abuse.totalReports ?? null,\n    abuse_whitelisted: abuse.isWhitelisted ?? null,\n    is_malicious: score >= 50,\n  }\n}];"
      },
